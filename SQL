/* =========================================================
   STEP 1 — CREATE DIMENSION & FACT TABLES
   ========================================================= */


/* ---------- TABLE 1 : DATE DIMENSION ---------- */

CREATE TABLE dim_date (
    TimeIndex      INTEGER PRIMARY KEY,
    FiscalYear     TEXT,
    FY_Label       TEXT,
    FY_Num         INTEGER,
    Month          TEXT,
    MonthShort     TEXT,
    MonthNum       INTEGER,
    Quarter        TEXT,
    IsAuditMonth   INTEGER
);


/* ---------- TABLE 2 : BANK DIMENSION ---------- */

CREATE TABLE dim_bank (
    BankID         INTEGER PRIMARY KEY,
    BankName       TEXT,
    BankType       TEXT,
    State          TEXT,
    Sponsor        TEXT,
    IsRRB          INTEGER,
    SLA_Target     REAL
);


/* ---------- TABLE 3 : SEVERITY LOOKUP ---------- */

CREATE TABLE dim_severity (
    SeverityID      INTEGER PRIMARY KEY,
    SeverityLabel   TEXT,
    FailMin         REAL,
    FailMax         REAL,
    Color           TEXT,
    Priority        INTEGER
);


/* ---------- TABLE 4 : FACT TABLE ---------- */

CREATE TABLE fact_nach_transactions (

    TimeIndex           INTEGER,
    BankID              INTEGER,

    BankName            TEXT,

    FiscalYear          TEXT,
    FY_Label            TEXT,
    FY_Num              INTEGER,

    Month               TEXT,
    MonthShort          TEXT,
    MonthNum            INTEGER,
    Quarter             TEXT,

    IsAuditMonth        INTEGER,

    success_pct         REAL,
    fail_pct            REAL,

    bus_pct             REAL,
    tech_pct            REAL,

    same_day_pct        REAL,

    resp_1d_pct         REAL,
    resp_2d_pct         REAL,
    resp_3d_pct         REAL,
    resp_4d_pct         REAL,

    ind_avg_fail        REAL,
    ind_avg_success     REAL,

    gap_vs_industry     REAL,

    mom_change          REAL,
    roll3_fail          REAL,

    sla_met             INTEGER,
    sla_status          TEXT,

    severity            TEXT,
    trend_dir           TEXT,

    SLA_Target          REAL,

    FOREIGN KEY(TimeIndex)
        REFERENCES dim_date(TimeIndex),

    FOREIGN KEY(BankID)
        REFERENCES dim_bank(BankID),

    FOREIGN KEY(severity)
        REFERENCES dim_severity(SeverityLabel)
);



